# Copy this file to .env and add credentials only for providers you use.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MAX_TOKENS=2048

# Configure these for an OpenAI-compatible endpoint.
COMPATIBLE_API_KEY=
COMPATIBLE_MODEL=
COMPATIBLE_BASE_URL=
# Defaults are Authorization and "Bearer ".
# COMPATIBLE_API_KEY_HEADER=api-key
# COMPATIBLE_API_KEY_PREFIX=

# Leave empty to use the platform's default application data directory.
OMNICHAT_DB_PATH=
OMNICHAT_REQUEST_TIMEOUT=60
OMNICHAT_REQUEST_RETRIES=1
